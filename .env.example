# HTTP port for the API (also serves the mock suppliers and the demo UI)
PORT=3000
# Redis connection
REDIS_URL=redis://localhost:6379
# Temporal frontend address and task queue
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=hotel-offers
# Base URL the worker uses to reach the mock supplier endpoints
SUPPLIER_BASE_URL=http://localhost:3000
# Per-request timeout when calling a supplier (ms)
SUPPLIER_TIMEOUT_MS=3000
# How long the deduplicated list stays in Redis (seconds)
CACHE_TTL_SECONDS=600
# Start a supplier in "down" mode (useful for demos)
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false
LOG_LEVEL=info

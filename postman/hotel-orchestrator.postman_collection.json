                },
                {
                  "key": "maxPrice",
                  "value": "1000"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Non-numeric price -> 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "minPrice",
                  "value": "abc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Supplier outage simulation",
      "item": [
        {
          "name": "Take Supplier A down",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/supplierA/toggle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierA",
                "toggle"
              ]
            },
            "description": "Sets supplierA DOWN (returns 503)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Supplier is down\", () => pm.expect(pm.response.json().down).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Hotels with Supplier A down",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "Supplier A returns 503; the activity is retried 3 times, then the workflow continues with Supplier B only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 (graceful degradation)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only Supplier B results\", () => pm.response.json().forEach(h => pm.expect(h.supplier).to.eql(\"Supplier B\")));",
                  "pm.test(\"X-Failed-Suppliers header\", () => pm.expect(pm.response.headers.get(\"X-Failed-Suppliers\")).to.eql(\"Supplier A\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health - degraded",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 503\", () => pm.response.to.have.status(503));",
                  "const b = pm.response.json();",
                  "pm.test(\"Overall degraded\", () => pm.expect(b.status).to.eql(\"degraded\"));",
                  "pm.test(\"Supplier A down\", () => pm.expect(b.suppliers.supplierA.status).to.eql(\"down\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Take Supplier B down",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/supplierB/toggle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierB",
                "toggle"
              ]
            },
            "description": "Sets supplierB DOWN (returns 503)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Supplier is down\", () => pm.expect(pm.response.json().down).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Hotels with both suppliers down -> 502",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 502\", () => pm.response.to.have.status(502));",
                  "pm.test(\"Error message\", () => pm.expect(pm.response.json().error).to.include(\"unavailable\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bring Supplier A up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/supplierA/toggle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierA",
                "toggle"
              ]
            },
            "description": "Sets supplierA UP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Supplier is up\", () => pm.expect(pm.response.json().down).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bring Supplier B up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/supplierB/toggle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierB",
                "toggle"
              ]
            },
            "description": "Sets supplierB UP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Supplier is up\", () => pm.expect(pm.response.json().down).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health - recovered",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Overall ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
